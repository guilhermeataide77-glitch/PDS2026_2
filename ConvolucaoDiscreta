import numpy as np
import matplotlib.pyplot as plt

def convolucao_manual(x, h):
    N = len(x)
    M = len(h)
    len_y = N + M - 1
    y = np.zeros(len_y)
    h_invertido = h[::-1]
    
    for n in range(len_y):
        soma = 0
        for k in range(M):
            idx_x = n - (M - 1) + k
            if 0 <= idx_x < N:
                soma += x[idx_x] * h_invertido[k]
        y[n] = soma
        
    return y

# DEFINIÇÃO DOS SINAIS 
x = np.array([1, 2, 3, 4, 5])
h = np.array([1, 0, -1])

# Calculo das convolucoes
y_manual = convolucao_manual(x, h)
y_numpy = np.convolve(x, h)

#  DEFINIÇÃO DOS INDICES N 
n_x = np.arange(len(x))
n_h = np.arange(len(h))
n_y = np.arange(len(y_manual))

# PLOTAGEM DOS GRAFICOS
plt.figure(figsize=(10, 8))

# 1. Sinal de Entrada x[n]
plt.subplot(3, 1, 1)
plt.stem(n_x, x, basefmt=" ")
plt.title("Sinal de Entrada x[n]")
plt.xlabel("n")
plt.ylabel("Amplitude")
plt.grid(True)

# 2. Resposta ao Impulso h[n]
plt.subplot(3, 1, 2)
plt.stem(n_h, h, basefmt=" ")
plt.title("Resposta ao Impulso h[n]")
plt.xlabel("n")
plt.ylabel("Amplitude")
plt.grid(True)

# 3. Resultado da Convolução y[n]
plt.subplot(3, 1, 3)
plt.stem(n_y, y_manual, label='Manual', basefmt=" ")
plt.stem(n_y, y_numpy, linefmt='r--', markerfmt='ro', label='np.convolve')
plt.title("Resultado da Convolução y[n] = x[n] * h[n]")
plt.xlabel("n")
plt.ylabel("Amplitude")
plt.legend()
plt.grid(True)

plt.tight_layout()
plt.show()

print("")

# IMPRESSÃO DOS VALORES E TESTE
print("Resultado da convolução manual:    ", y_manual)
print("")
print("Resultado NumPy:     ", y_numpy)
print("")
if np.array_equal(y_manual, y_numpy):
    print("Os resultados são EXATAMENTE IGUAIS")
